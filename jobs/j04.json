{
  "requester_id": "req-hw7-01",
  "description": "Extract the vendor, invoice number, invoice date, currency, line items, subtotal, tax and total from paper invoices our small US suppliers mail us, which we scan in. Every file is a scanned image with no text layer, slightly tilted and blurred, in a compact layout with 1 to 8 line items each, in US dollars. About half of the suppliers don't charge sales tax, so about half of the invoices have no tax line.",
  "output_description": "One JSON object per invoice, matching output_schema: dates as YYYY-MM-DD, currency as an ISO 4217 code, amounts as plain numbers. Use null for an invoice number, subtotal or tax that isn't printed.",
  "output_schema": {
    "$defs": {
      "LineItem": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "unit_price": {
            "title": "Unit Price",
            "type": "number"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          }
        },
        "required": [
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "title": "LineItem",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "vendor_name": {
        "title": "Vendor Name",
        "type": "string"
      },
      "invoice_number": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Invoice Number"
      },
      "invoice_date": {
        "description": "ISO 8601 date, YYYY-MM-DD",
        "title": "Invoice Date",
        "type": "string"
      },
      "currency": {
        "description": "ISO 4217 code, e.g. USD",
        "title": "Currency",
        "type": "string"
      },
      "line_items": {
        "items": {
          "$ref": "#/$defs/LineItem"
        },
        "title": "Line Items",
        "type": "array"
      },
      "subtotal": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Subtotal"
      },
      "tax": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Tax"
      },
      "total": {
        "title": "Total",
        "type": "number"
      }
    },
    "required": [
      "vendor_name",
      "invoice_number",
      "invoice_date",
      "currency",
      "line_items",
      "subtotal",
      "tax",
      "total"
    ],
    "title": "Invoice",
    "type": "object"
  },
