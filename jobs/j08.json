{
  "requester_id": "req-hw7-01",
  "description": "Extract the vendor, invoice number, invoice date, currency, line items, subtotal, tax and total from invoices from our UK suppliers. They are digital PDFs priced in pounds sterling (GBP) with 20% VAT, with 1 to 8 line items each.",
  "output_description": "One JSON object per invoice, matching output_schema: dates as YYYY-MM-DD, currency as an ISO 4217 code, amounts as plain numbers. Use null for an invoice number, subtotal or tax that isn't printed.",
